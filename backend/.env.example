# faster-whisper
WHISPER_MODEL=small          # switch to "medium" once the pipeline works end-to-end
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# segmentation
SEGMENTATION_METHOD=sbert    # "sbert" (default) or "texttiling"

# ListenNotes (Spotify podcast ingestion) -- free key at https://www.listennotes.com/api/
LISTENNOTES_API_KEY=

# CORS -- add your frontend's origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
